{
  "name": "bull-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/runtime",
    "packages/core",
    "packages/eslint-plugin",
    "packages/cli",
    "packages/create",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build -w @bull-js/runtime -w @bull-js/core -w @bull-js/eslint-plugin -w @bull-js/cli -w @bull-js/create",
    "test": "vitest run",
    "test:e2e": "npm run build && vitest run -c vitest.e2e.config.ts",
    "typecheck": "tsc -p packages/runtime --noEmit && tsc -p packages/core --noEmit && tsc -p packages/cli --noEmit && tsc -p packages/eslint-plugin --noEmit && tsc -p packages/create --noEmit",
    "docs": "node packages/cli/dist/bin.js explain --all --format md --out docs/rules",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only",
    "release": "npm run build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@changesets/cli": "^3.0.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
