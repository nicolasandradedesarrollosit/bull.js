{
  "name": "@bull-js/cli",
  "version": "0.2.0",
  "description": "Bull: the opinionated React framework that refuses to build unless you respect MVVM.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/nicolasandradedesarrollosit/bull.js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicolasandradedesarrollosit/bull.js.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/nicolasandradedesarrollosit/bull.js/issues"
  },
  "keywords": [
    "react",
    "mvvm",
    "vite",
    "framework",
    "cli",
    "architecture",
    "linter"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "bull": "./dist/bin.js"
  },
  "files": [
    "dist",
    "templates",
    "!templates/**/node_modules"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./create": {
      "types": "./dist/create.d.ts",
      "import": "./dist/create.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup src/index.ts src/bin.ts src/create.ts --format esm --dts --clean --external @bull-js/core"
  },
  "dependencies": {
    "@bull-js/core": "^0.2.0",
    "@clack/prompts": "^1.8.1",
    "@vitejs/plugin-react": "^6.1.2",
    "cac": "^6.7.14",
    "picocolors": "^1.1.1",
    "vite": "^8.3.4"
  }
}
