{
  "name": "@bull-js/eslint-plugin",
  "version": "0.3.1",
  "description": "Bull's MVVM architecture rules, in your editor.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/nicolasandradedesarrollosit/bull.js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicolasandradedesarrollosit/bull.js.git",
    "directory": "packages/eslint-plugin"
  },
  "bugs": {
    "url": "https://github.com/nicolasandradedesarrollosit/bull.js/issues"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "mvvm",
    "architecture",
    "react"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external @bull-js/core"
  },
  "peerDependencies": {
    "eslint": ">=9"
  },
  "dependencies": {
    "@bull-js/core": "^0.3.1",
    "@typescript-eslint/parser": "^8.72.0"
  }
}
