{
  "name": "@bull/eslint-plugin",
  "version": "0.2.0",
  "description": "Bull's MVVM architecture rules, in your editor.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/nicolasandradedesarrollosit/bull.js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicolasandradedesarrollosit/bull.js.git",
    "directory": "packages/eslint-plugin"
  },
  "bugs": {
    "url": "https://github.com/nicolasandradedesarrollosit/bull.js/issues"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "mvvm",
    "architecture",
    "react"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external @bull/core"
  },
  "peerDependencies": {
    "eslint": ">=9"
  },
  "dependencies": {
    "@bull/core": "^0.2.0",
    "@typescript-eslint/parser": "^8.71.1"
  }
}
