{
  "name": "@triad/eslint-plugin",
  "version": "0.1.0",
  "description": "Triad's MVVM architecture rules, in your editor.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external @triad/core"
  },
  "peerDependencies": {
    "eslint": ">=9"
  },
  "dependencies": {
    "@triad/core": "^0.1.0",
    "@typescript-eslint/parser": "^8.71.1"
  }
}
