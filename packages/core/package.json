{
  "name": "@bull-js/core",
  "version": "0.3.1",
  "description": "Bull's MVVM architecture analysis engine.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/nicolasandradedesarrollosit/bull.js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicolasandradedesarrollosit/bull.js.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/nicolasandradedesarrollosit/bull.js/issues"
  },
  "keywords": [
    "mvvm",
    "architecture",
    "linter",
    "static-analysis",
    "react"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean"
  },
  "dependencies": {
    "@typescript-eslint/typescript-estree": "^8.71.1",
    "picocolors": "^1.1.1"
  }
}
