{
  "name": "@bull/runtime",
  "version": "0.2.0",
  "description": "Bull's MVVM runtime: observable state, ViewModels, commands and React bindings.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/nicolasandradedesarrollosit/bull#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicolasandradedesarrollosit/bull.git",
    "directory": "packages/runtime"
  },
  "bugs": {
    "url": "https://github.com/nicolasandradedesarrollosit/bull/issues"
  },
  "keywords": [
    "react",
    "mvvm",
    "viewmodel",
    "signals",
    "reactive",
    "state-management",
    "dependency-injection"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup src/index.ts src/react.tsx --format esm --dts --clean --external react --external react-dom"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
